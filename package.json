{
  "name": "helix-editor-plugins",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "npm run fonts:fetch",
    "dev": "vite dev",
    "prebuild": "npm run fonts:fetch && npm run generate:favicon-ico && npm run generate:og-image",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "generate:og-image": "node scripts/og-image/generate.mjs",
    "generate:favicon-ico": "node scripts/favicon/generate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "phosphor-icons-svelte": "^2.1.0"
  }
}
